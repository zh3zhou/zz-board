# Optional path to a writable local data directory. Development defaults to .local-data on this drive.
ZZ_BOARD_DATA_DIR=
ZZ_BOARD_PORT=4318
# Optional explicit Codex CLI executable. Otherwise the bridge resolves codex from PATH.
CODEX_CLI_PATH=
# Optional public feedback configuration, after cloud acceptance. These are public
# anon credentials only; never place a service_role or administrator key here.
# Export them as process environment variables for local development.
ZZ_BOARD_FEEDBACK_ENV_ID=
ZZ_BOARD_FEEDBACK_PUBLISHABLE_KEY=
