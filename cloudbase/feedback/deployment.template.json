{
  "schemaVersion": 1,
  "region": "ap-shanghai",
  "entrypoint": "tcbopenapi",
  "httpApiPath": "/v1/functions/zzb-feedback?webfn=true",
  "httpFunction": {
    "name": "zzb-feedback",
    "type": "HTTP",
    "runtime": "Nodejs24.11",
    "timeout": 20,
    "installDependency": false,
    "envVariables": { "ZZB_FEEDBACK_ENABLED": "false" }
  },
  "cleanupFunction": {
    "name": "zzb-feedback-cleanup",
    "type": "Event",
    "runtime": "Nodejs24.11",
    "handler": "index.main",
    "timeout": 20,
    "installDependency": false,
    "envVariables": {},
    "triggers": []
  },
  "postAcceptanceTimer": { "name": "zzb-feedback-daily-cleanup", "type": "timer", "config": "0 0 2 * * * *" },
  "migration": { "version": "20261011050000", "name": "zzb_feedback", "file": "cloudbase/migrations/20261011050000_zzb_feedback.sql" },
  "followUpMigrations": [
    { "version": "20261127060000", "name": "zzb_feedback_processing", "file": "cloudbase/migrations/20261127060000_zzb_feedback_processing.sql" },
    { "version": "20261127070000", "name": "zzb_feedback_scoped", "file": "cloudbase/migrations/20261127070000_zzb_feedback_scoped.sql" }
