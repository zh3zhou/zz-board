  "rateLimit": { "scope": "global", "perActionPerMinute": 30, "newReportsPerUtcDay": 500, "withdrawalsPerUtcDay": 500, "duplicateSubmissionsConsumeDailyReportBudget": false, "sourceIpHash": false },
  "gates": ["existing-package-no-new-charges", "new-prefix-collision-free", "existing-policy-preserved-without-OPA-migration", "cleanup-denied-to-public-clients", "verified-private-network-and-TLS", "restricted-intake-and-retention-logins-tested-separately", "log-and-backup-retention-disclosed", "publishable-key-webfn-synthetic-acceptance", "concurrent-submit-delete-and-quota-acceptance"]
}
