  "credentialEnvNames": ["ZZB_FEEDBACK_PG_HOST", "ZZB_FEEDBACK_PG_PORT", "ZZB_FEEDBACK_PG_DATABASE", "ZZB_FEEDBACK_PG_USER", "ZZB_FEEDBACK_PG_PASSWORD"],
  "optionalCredentialEnvNames": ["ZZB_FEEDBACK_PG_CA"],
