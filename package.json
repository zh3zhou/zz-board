{
  "name": "zz-board",
  "version": "0.11.0",
  "private": true,
  "description": "A local-first spatial board for evidence-backed Codex project briefs, human actions, and notes.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n bridge,web \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "dev:trial": "vite --config scripts/vite-trial.config.ts",
    "build:trial": "vite build --config scripts/vite-trial.config.ts",
    "preview:trial": "vite preview --config scripts/vite-trial.config.ts",
    "trial:diagnostics": "tsx scripts/trial-diagnostics.ts",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "desktop:prepare": "pnpm build && node scripts/build-desktop-sidecar.mjs",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-tauri.ps1 -Mode dev",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-tauri.ps1 -Mode build",
    "desktop:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-smoke.ps1",
    "setup:windows": "node scripts/source-deployment.mjs setup",
    "cloudbase:package": "node scripts/cloudbase-feedback-package.mjs",
    "cloudbase:plan": "node scripts/cloudbase-feedback-plan.mjs",
    "cloudbase:smoke": "node scripts/cloudbase-feedback-deploy-smoke.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/integration/**",
    "test:e2e": "vitest run tests/integration",
    "smoke:windows": "node scripts/smoke.mjs",
    "board": "tsx scripts/board-cli.ts",
    "skin": "tsx scripts/skin-cli.ts",
    "validate:skill": "node scripts/validate-skill.mjs",
    "validate:skill:installed": "node scripts/validate-skill.mjs --check-installed",
    "sync:skill": "node scripts/sync-skill.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build && pnpm validate:skill"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@xyflow/react": "^12.9.3",
    "fastify": "^5.6.1",
    "html-to-image": "1.11.13",
    "perfect-freehand": "1.2.3",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "postgres": "3.4.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.0.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zh3zhou/zz-board.git"
  },
  "homepage": "https://github.com/zh3zhou/zz-board#readme"
}
